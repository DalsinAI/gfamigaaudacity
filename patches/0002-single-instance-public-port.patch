+#if defined(__AMIGA__)
+// AmigaOS: one Audacity, found by its public message port. A second start
+// sends the files named on its command line to that port (an empty name
+// brings the running Audacity to the front) and quits.
+#include <proto/exec.h>
+#include <exec/ports.h>
+
+static const char AmigaIPCPortName[] = "Audacity.ipc";
+
+namespace {
+struct AmigaIPCMessage
+{
+   struct Message msg;
+   wchar_t name[1024];
+};
+}
+
+void AmigaIPCPoll(struct MsgPort *port)
+{
+   if (!port)
+      return;
+   struct Message *m;
+   while ((m = GetMsg(port)) != nullptr) {
+      auto im = reinterpret_cast<AmigaIPCMessage *>(m);
+      im->name[1023] = 0;
+      ofqueue.push_back(wxString(im->name));
+      ReplyMsg(m);
+   }
+}
+
+bool AudacityApp::CreateSingleInstanceChecker(const wxString & /* dir */)
+{
+   Forbid();
+   struct MsgPort *other = FindPort(AmigaIPCPortName);
+   if (!other) {
+      mIPCPort = CreateMsgPort();
+      if (mIPCPort) {
+         mIPCPort->mp_Node.ln_Name = const_cast<char *>(AmigaIPCPortName);
+         mIPCPort->mp_Node.ln_Pri = 0;
+         AddPort(mIPCPort);
+      }
+      Permit();
+      // the first Audacity, port or not
+      return true;
+   }
+   Permit();
+
+   // Parse the command line to ensure correct syntax, but ignore
+   // options other than -v, and only use the filenames, if any.
+   auto parser = ParseCommandLine();
+   if (!parser)
+      return false;
+   if (parser->Found(wxT("v"))) {
+      wxPrintf("Audacity v%s\n", AUDACITY_VERSION_STRING);
+      return false;
+   }
+
+   struct MsgPort *reply = CreateMsgPort();
+   if (!reply)
+      return false;
+   auto send = [reply](const wxString &name) {
+      AmigaIPCMessage m{};
+      m.msg.mn_Node.ln_Type = NT_MESSAGE;
+      m.msg.mn_Length = sizeof(m);
+      m.msg.mn_ReplyPort = reply;
+      size_t i = 0;
+      for (auto c : name) {
+         if (i == 1023)
+            break;
+         m.name[i++] = static_cast<wchar_t>(static_cast<wxUniChar>(c).GetValue());
+      }
+      m.name[i] = 0;
+      Forbid();
+      struct MsgPort *port = FindPort(AmigaIPCPortName);
+      if (port)
+         PutMsg(port, &m.msg);
+      Permit();
+      if (port) {
+         WaitPort(reply);
+         GetMsg(reply);
+      }
+   };
+   for (size_t j = 0, cnt = parser->GetParamCount(); j < cnt; ++j) {
+      wxFileName filename(parser->GetParam(j));
+      if (filename.MakeAbsolute())
+         send(filename.GetLongPath());
+   }
+   send(wxEmptyString);
+   DeleteMsgPort(reply);
+
+   // the running Audacity has the files: this one stops
+   return false;
+}
+
+static void AmigaIPCClose(struct MsgPort *&port)
+{
+   if (!port)
+      return;
+   Forbid();
+   RemPort(port);
+   struct Message *m;
+   while ((m = GetMsg(port)) != nullptr)
+      ReplyMsg(m);
+   Permit();
+   DeleteMsgPort(port);
+   port = nullptr;
+}
