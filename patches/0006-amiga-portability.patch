diff -ruN a/modules/scripting/CMakeLists.txt b/modules/scripting/CMakeLists.txt
--- a/modules/scripting/CMakeLists.txt	2026-11-05 00:31:44.524432721 +0000
+++ b/modules/scripting/CMakeLists.txt	2026-11-05 00:31:58.476905679 +0000
@@ -7,7 +7,11 @@
 # The list of modules is ordered so that each module occurs after any others
 # that it depends on
 set( MODULES
-   mod-script-pipe
 )
+# AmigaOS: every module is linked into the program and so always on; the
+# scripting pipe stays out until it has an Amiga pipe of its own
+if( NOT AMIGA )
+   list( APPEND MODULES mod-script-pipe )
+endif()
 
