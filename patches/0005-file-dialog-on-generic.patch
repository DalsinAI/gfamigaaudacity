@@ -0,0 +1,135 @@
+/**********************************************************************
+
+  Audacity: A Digital Audio Editor
+
+  FileDialogPrivate.cpp (AmigaOS, gfopenwx's openlayout port)
+
+  Copyright (c) 2026 AmiCradle Team
+
+**********************************************************************/
+
+#include "../FileDialog.h"
+
+#include <wx/filename.h>
+#include <wx/generic/filedlgg.h>
+
+// the dialog being shown, for the extra-control creator (which has no
+// user data of its own); file dialogs are modal, one at a time
+static FileDialog *sShowing = nullptr;
+
+FileDialog::FileDialog(wxWindow *parent,
+                       const wxString& message,
+                       const wxString& defaultDir,
+                       const wxString& defaultFile,
+                       const wxString& wildCard,
+                       long style,
+                       const wxPoint& pos,
+                       const wxSize& sz,
+                       const wxString& name)
+{
+   Create(parent, message, defaultDir, defaultFile, wildCard, style, pos, sz, name);
+}
+
+bool FileDialog::Create(wxWindow *parent,
+                        const wxString& message,
+                        const wxString& defaultDir,
+                        const wxString& defaultFile,
+                        const wxString& wildCard,
+                        long style,
+                        const wxPoint& pos,
+                        const wxSize& WXUNUSED(sz),
+                        const wxString& WXUNUSED(name))
+{
+   mParent = parent;
+   mPos = pos;
+   m_message = message;
+   m_dir = defaultDir;
+   m_fileName = defaultFile;
+   m_wildCard = wildCard.empty() ? wxString(wxFileSelectorDefaultWildcardStr) : wildCard;
+   m_windowStyle = style;
+   m_filterIndex = 0;
+   if (!m_dir.empty() || !m_fileName.empty())
+      m_path = wxFileName(m_dir, m_fileName).GetFullPath();
+   return true;
+}
+
+FileDialog::~FileDialog()
+{
+}
+
+wxString FileDialog::GetPath() const { return m_path; }
+
+void FileDialog::GetPaths(wxArrayString& paths) const
+{
+   paths = mPaths;
+   if (paths.empty() && !m_path.empty())
+      paths.Add(m_path);
+}
+
+wxString FileDialog::GetFilename() const { return m_fileName; }
+
+void FileDialog::GetFilenames(wxArrayString& files) const
+{
+   files = mNames;
+   if (files.empty() && !m_fileName.empty())
+      files.Add(m_fileName);
+}
+
+int FileDialog::GetFilterIndex() const { return m_filterIndex; }
+
+void FileDialog::SetMessage(const wxString& message) { m_message = message; }
+
+void FileDialog::SetPath(const wxString& path)
+{
+   m_path = path;
+   wxFileName fn(path);
+   m_dir = fn.GetPath();
+   m_fileName = fn.GetFullName();
+}
+
+void FileDialog::SetDirectory(const wxString& dir) { m_dir = dir; }
+
+void FileDialog::SetFilename(const wxString& name) { m_fileName = name; }
+
+void FileDialog::SetWildcard(const wxString& wildCard) { m_wildCard = wildCard; }
+
+void FileDialog::SetFilterIndex(int filterIndex) { m_filterIndex = filterIndex; }
+
+wxWindow *FileDialog::MakeUserPane(wxWindow *parent)
+{
+   if (!sShowing)
+      return nullptr;
+   // CreateUserPane adds its controls to a panel of ours
+   auto panel = new wxPanel(parent);
+   sShowing->CreateUserPane(panel);
+   panel->Fit();
+   return panel;
+}
+
+int FileDialog::ShowModal()
+{
+   wxGenericFileDialog dlg(mParent, m_message, m_dir, m_fileName, m_wildCard,
+                           m_windowStyle, mPos);
+   dlg.SetFilterIndex(m_filterIndex);
+   if (HasUserPaneCreator())
+      dlg.SetExtraControlCreator(&FileDialog::MakeUserPane);
+
+   sShowing = this;
+   const int result = dlg.ShowModal();
+   sShowing = nullptr;
+
+   if (result == wxID_OK) {
+      m_path = dlg.GetPath();
+      m_dir = dlg.GetDirectory();
+      m_fileName = dlg.GetFilename();
+      m_filterIndex = dlg.GetFilterIndex();
+      mPaths.clear();
+      mNames.clear();
+      if (HasFdFlag(wxFD_MULTIPLE)) {
+         dlg.GetPaths(mPaths);
+         dlg.GetFilenames(mNames);
+      }
+   }
+   SetReturnCode(result);
+   return result;
+}
