+// Sample and summary blobs are little endian in every .aup3. A big-endian
+// host (AmigaOS on 68k) swaps each element on the way in and out, so its
+// projects open everywhere and theirs open on it.
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+#define SAMPLEBLOCK_SWAP_BYTES 1
+static void SwapElements(char *data, size_t bytes, size_t size)
+{
+   if (size < 2)
+      return;
+   for (size_t i = 0; i + size <= bytes; i += size)
+      for (size_t a = i, b = i + size - 1; a < b; ++a, --b) {
+         char t = data[a];
+         data[a] = data[b];
+         data[b] = t;
+      }
+}
+static std::vector<char> SwappedCopy(const char *data, size_t bytes, size_t size)
+{
+   std::vector<char> copy(data, data + bytes);
+   SwapElements(copy.data(), bytes, size);
+   return copy;
+}
+#endif
 
 class SqliteSampleBlockFactory;
 
