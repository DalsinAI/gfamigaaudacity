+      if (options.cancelButton)
+         return BasicUI::MessageBoxResult::Cancel;
+      if (options.buttonStyle == BasicUI::Button::YesNo)
+         return BasicUI::MessageBoxResult::No;
+      return BasicUI::MessageBoxResult::Ok;
+   }
+   std::unique_ptr<BasicUI::ProgressDialog> DoMakeProgress(
