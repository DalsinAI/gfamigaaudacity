+   { return mPrev->DoMakeProgress(title, message, flags, remainingLabelText); }
+   std::unique_ptr<BasicUI::GenericProgressDialog> DoMakeGenericProgress(
+      const BasicUI::WindowPlacement &placement, const TranslatableString &title,
+      const TranslatableString &message, int style) override
+   { return mPrev->DoMakeGenericProgress(placement, title, message, style); }
+   int DoMultiDialog(const TranslatableString &message,
+      const TranslatableString &title, const TranslatableStrings &,
+      const ManualPageID &, const TranslatableString &, bool) override
+   { Say(title, message); return 0; }
+   bool DoOpenInDefaultBrowser(const wxString &url) override
+   { return mPrev->DoOpenInDefaultBrowser(url); }
+   std::unique_ptr<BasicUI::WindowPlacement> DoFindFocus() override
+   { return mPrev->DoFindFocus(); }
+   void DoSetFocus(const BasicUI::WindowPlacement &focus) override
+   { mPrev->DoSetFocus(focus); }
+   bool IsUsingRtlLayout() const override { return mPrev->IsUsingRtlLayout(); }
+   bool IsUiThread() const override { return mPrev->IsUiThread(); }
+
+   void Say(const TranslatableString &title, const TranslatableString &message)
+   {
+      wxString line = title.Translation();
+      if (!line.empty())
+         line += wxT(": ");
+      line += message.Translation();
+      line.Replace(wxT("\n\n"), wxT(" "));
+      line.Replace(wxT("\n"), wxT(" "));
+      if (!mSaid.empty())
+         mSaid += wxT(" / ");
+      mSaid += line;
+   }
+
+private:
+   BasicUI::Services *mPrev;
+   wxString &mSaid;
+};
+
+// For one command: message boxes and dialogs kept, not shown
+class AmigaRexxQuiet {
+public:
+   AmigaRexxQuiet() : mUI(BasicUI::Get(), mSaid)
+   {
+      mPrev = BasicUI::Install(&mUI);
+      AmigaQuietMessageBox = [this](const TranslatableString &message,
+         const TranslatableString &caption, long style) {
+         mUI.Say(caption, message);
+         if (style & wxCANCEL)
+            return wxCANCEL;
+         if (style & wxYES_NO)
+            return wxNO;
+         return wxOK;
+      };
+   }
+   ~AmigaRexxQuiet()
+   {
+      AmigaQuietMessageBox = nullptr;
+      BasicUI::Install(mPrev);
+   }
+   const wxString &Said() const { return mSaid; }
+
+private:
+   wxString mSaid;
+   AmigaRexxQuietUI mUI;
+   BasicUI::Services *mPrev;
+};
+
+static void AmigaRexxFail(wxARexxCommand &c, long rc, const wxString &why)
+{
+   sAmigaRexxError = why;
+   c.SetError(rc);
+}
 
 static void AmigaRexxDo(wxARexxCommand &c, wxString in)
 {
    wxString out;
+   AmigaRexxQuiet quiet;
    ExecFromMain(&in, &out);
+   if (!quiet.Said().empty()) {
+      AmigaRexxFail(c, 10, quiet.Said());
+      return;
+   }
    // the answer's last line says how it went
    const wxString done = wxT("BatchCommand finished: ");
    int at = out.Find(done);
    if (at == wxNOT_FOUND) {
-      c.SetError(10);
+      AmigaRexxFail(c, 10, out.Strip(wxString::both));
       return;
    }
    wxString status = out.Mid(at + done.length());
    wxString answer = out.Left(at);
    answer.Trim();
    if (!status.StartsWith(wxT("OK")))
-      c.SetError(10);
+      AmigaRexxFail(c, 10, answer.empty() ? status.Strip(wxString::both) : answer);
    else
       c.SetResult(answer);
 }
