+class AmigaRexxQuietUI final : public BasicUI::Services {
+public:
+   AmigaRexxQuietUI(BasicUI::Services *prev, wxString &said)
+      : mPrev(prev), mSaid(said) {}
+   void DoCallAfter(const BasicUI::Action &action) override
+   { mPrev->DoCallAfter(action); }
